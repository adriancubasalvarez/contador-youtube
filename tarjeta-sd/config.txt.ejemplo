# Contador YouTube: configuración sin móvil · setup without a phone
#
# 1. Copia este archivo a la raíz de la tarjeta microSD con el nombre config.txt
#    Copy this file to the root of the microSD card, named config.txt
# 2. Rellena los datos (sin comillas) y enciende el contador con la tarjeta puesta.
#    Al leerlo, lo renombra a config_aplicada.txt y tapa la contraseña.
#    Fill in your details (no quotes) and power on the counter with the card in.
#    It renames the file to config_aplicada.txt and masks the password.
# Las líneas que empiezan por # no cuentan. Lo que dejes vacío no se cambia.
# Lines starting with # are ignored. Empty values are not changed.
# También valen las claves en inglés: password=, channel=, api_key=, language=

wifi=NombreDeTuWiFi
contrasena=ContraseñaDeTuWiFi
canal=@tucanal

# Tu clave de la API de YouTube (obligatoria si no la pusiste con el instalador
# o en la página de configuración; cómo conseguirla: paso 1 del manual):
# Your YouTube API key (step 1 of the manual):
clave_api=

# Idioma del contador · counter language: es (español) o/or en (English)
idioma=es
